# Goose
GOOSE_DRIVER=mysql
GOOSE_DBSTRING='example:example@tcp(127.0.0.1:3306)/example?charset=utf8mb4&parseTime=True&loc=UTC'
GOOSE_MIGRATION_DIR=internal/db/migrations

# Actions
AWS_REGION=
AWS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_ENDPOINT=

# Telegram
TELEGRAM__TOKEN=<YOUR_TELEGRAM_TOKEN>
TELEGRAM__PROXY_URL=
TELEGRAM__TIMEOUT=60s
# polling (default) or webhook; webhook needs manual Bot API registration (see README)
TELEGRAM__MODE=polling

# HTTP client (app-wide default; the bot's proxy/timeout always come from TELEGRAM__* above)
HTTP_CLIENT__PROXY_URL=
HTTP_CLIENT__BYPASS=
# duration; 0s = no client timeout
HTTP_CLIENT__TIMEOUT=0s
HTTP_CLIENT__MAX_IDLE_CONNS=
HTTP_CLIENT__MAX_IDLE_CONNS_PER_HOST=
# duration; 0s = inherit the default transport
HTTP_CLIENT__IDLE_CONN_TIMEOUT=0s
HTTP_CLIENT__TLS__ROOT_CA_FILE=
HTTP_CLIENT__TLS__ROOT_CA_PEM=
HTTP_CLIENT__TLS__ROOT_CA_REPLACE_SYSTEM=
